	  <add name="userdirectory" connectionString="HCILBAPROD" />
    <!--<add name="tkthost" connectionString="HCILSMAARTPRD"/>
    <add name="userdirectory" connectionString="HCILBAPROD"/>-->
    <add name="port" connectionString=":443" />
    <add name="port_tkt" connectionString="4243" />
    <add name="hostType" connectionString="https" />
    <add name="ticketURL" connectionString="http://localhost:3000/auth/" />
    <add name="ApplicationServices" connectionString="data source=.\SQLEXPRESS;Integrated Security=SSPI;AttachDBFilename=|DataDirectory|\aspnetdb.mdf;User Instance=true" providerName="System.Data.SqlClient" />
    <add name="constr1" connectionString="Data Source=localhost;Initial Catalog=honda;Integrated Security=False;User ID=root;Password=sa@123;Connection Timeout=1800;Charset=utf8mb4;" />
    <add name="constr" connectionString="server=localhost;database=honda;uid=root;pwd=sa@123;Connection Timeout=1800;Charset=utf8mb4;" />
