  <connectionStrings>
    <add name="SMTPPort" connectionString="25" />
    <add name="SMTPServer" connectionString="10.117.22.76" />
	<!--<add name="SMTPServer" connectionString="10.116.106.6" />-->
    <add name="SMTPUserName" connectionString="SMAART Helpdesk" />
    <add name="SMTPPassword" connectionString="password@1" />
    <add name="FromEmail" connectionString="smaarthelpdesk@hondacarindia.com" />
    <add name="EnableSSL" connectionString="false" />
    <!--
  <add name="SMTPPort" connectionString="25" />
