    <add name="Resetlink" connectionString="https://hcilsmaartuat.hondacarindia.com:1010/" />
    <add name="MailSubject" connectionString="Reset your SMAART password" />
    <add name="MailRegards" connectionString="Honda SMAART Help desk" />
    <add name="ExpMinutes" connectionString="15" />
    <add name="method" connectionString="POST" />
    <!--<add name="host" connectionString="hcilsmaartuat" />-->
	  <add name="host" connectionString="hcilsmaartuat.hondacarindia.com" />
	  <!--<add name="host" connectionString="smaart.hondacarindia.com"/>-->
	  <!--<add name="tkthost" connectionString="hcilsmaartuat" />-->
